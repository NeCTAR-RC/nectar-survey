{
  "name": "nectar-survey",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:editor": "vite --config vite.editor.config.ts",
    "build": "tsc -b && vite build && vite build --config vite.editor.config.ts",
    "lint:js": "eslint .",
    "lint:scss": "stylelint --allow-empty-input \"src/**/*.scss\" \"editor/**/*.scss\"",
    "lint": "pnpm lint:js && pnpm lint:scss && pnpm format:check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.scss": [
      "stylelint --fix"
    ],
    "*.{ts,tsx,scss,css,json,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ardc-ui/react": "^5.1.0",
    "@internationalized/date": "^3.12.4",
    "react": "^19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-stately": "3.51.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "sass": "^1.106.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "download"
    }
  }
}
